# Used via -DCMAKE_PROJECT_INCLUDE=<this file> -DRENAME_TARGETS="a;b" -DRENAME_PREFIX=lib [-DRENAME_SUFFIX=1]
# Renames the output (dll + import lib) of the given targets to <prefix><target name><suffix>.
# Module-definition (.def) sources that carry "LIBRARY <name>" are patched to the new name as well, otherwise the
# import library would still reference the old DLL name. Applied at the end of the top-level configure step
# (cmake_language DEFER, CMake >= 3.19).
function(_rename_outputs_now)
  foreach(t IN LISTS RENAME_TARGETS)
    if(NOT TARGET ${t})
      message(WARNING "rename_outputs: target ${t} not found")
      continue()
    endif()
    set(newname "${RENAME_PREFIX}${t}${RENAME_SUFFIX}")
    set_target_properties(${t} PROPERTIES OUTPUT_NAME "${newname}")
    get_target_property(_srcs ${t} SOURCES)
    get_target_property(_sd ${t} SOURCE_DIR)
    set(_new "")
    foreach(s IN LISTS _srcs)
      if(s MATCHES "\\.def$")
        if(IS_ABSOLUTE "${s}")
          set(_abs "${s}")
        else()
          set(_abs "${_sd}/${s}")
        endif()
        file(READ "${_abs}" _c)
        string(REGEX REPLACE "(^|\n)LIBRARY[^\n]*" "\\1LIBRARY ${newname}" _c "${_c}")
        file(WRITE "${CMAKE_BINARY_DIR}/rename_def/${t}.def" "${_c}")
        list(APPEND _new "${CMAKE_BINARY_DIR}/rename_def/${t}.def")
      else()
        list(APPEND _new "${s}")
      endif()
    endforeach()
    set_property(TARGET ${t} PROPERTY SOURCES "${_new}")
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _rename_outputs_now)