--- a/cocos/CMakeLists.txt
+++ b/cocos/CMakeLists.txt
@@ -34,6 +34,11 @@
 
 set(COCOS_CORE_LIB cocos2d)
 
+# Optional modules, OFF by default: there are no x64 builds of curl/openssl/libwebsockets/libuv/Box2D/Bullet
+# (see tools/build_deps_x64.ps1). Turn them ON only after providing x64 builds of those libraries.
+option(COCOS_USE_NETWORK "Build the network module (HttpClient, WebSocket, SocketIO, Downloader)" OFF)
+option(COCOS_USE_BULLET_BOX2D "Link Box2D and Bullet (3D physics)" OFF)
+
 include(2d/CMakeLists.txt)
 include(3d/CMakeLists.txt)
 include(platform/CMakeLists.txt)
@@ -46,7 +51,9 @@
 include(base/CMakeLists.txt)
 include(deprecated/CMakeLists.txt)
 include(ui/CMakeLists.txt)
-include(network/CMakeLists.txt)
+if(COCOS_USE_NETWORK)
+    include(network/CMakeLists.txt)
+endif()
 include(audio/CMakeLists.txt)
 include(storage/CMakeLists.txt)
 
@@ -119,6 +126,11 @@
 
 add_library(cocos2d ${COCOS_SRC})
 
+if(NOT COCOS_USE_BULLET_BOX2D)
+    # physics3d sources are guarded by CC_ENABLE_BULLET_INTEGRATION, which ccConfig.h only defines when this is non-zero
+    target_compile_definitions(cocos2d PUBLIC CC_USE_3D_PHYSICS=0)
+endif()
+
 # use external libs
 add_subdirectory(${COCOS2DX_ROOT_PATH}/external ${ENGINE_BINARY_PATH}/external)
 target_link_libraries(cocos2d external)
