 elseif(WINDOWS)
     set(platform_name win32)
-    set(platform_spec_path win32)
+    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
+        # x64 prebuilt binaries live next to the win32 ones in a "win64" folder (built by tools/build_deps_x64.ps1).
+        # Headers are shared with win32 (platform_name stays win32).
+        set(win_arch_dir win64)
+        set(win_prebuilt_subdir "win64/")
+    else()
+        set(win_arch_dir win32)
+        set(win_prebuilt_subdir "")
+    endif()
+    set(platform_spec_path ${win_arch_dir})
 elseif(MACOSX)
     set(platform_name mac)
     set(platform_spec_path mac)
